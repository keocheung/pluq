# Universal ignores for Gemini context (NOT a mirror of .gitignore).
# Gemini SEES: .workspace/ (session plans), all docs/, all source.

# Build artifacts
/target/
**/target/
crates/*/Cargo.lock

# Secrets — never expose
.env
.env.*

# Other agents' / editor / OS private dirs
.DS_Store
.idea/
.vscode/
.claude/
.agents/
.antigravitycli/

# Dev crate output
crates/archive-dev/output/
