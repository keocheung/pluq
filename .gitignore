# Rust build artifacts
/target/
**/target/

# Cargo lock files — keep root lock, ignore crate-level ones
crates/*/Cargo.lock

# Personal / transient workspace (session plans, scratch, sandbox, dev dumps)
.workspace/

# Agent / editor / OS / tool files
.DS_Store
.idea/
.vscode/
.gemini/
.claude/
.agents/
.antigravitycli/
*.swp
*.swo
*.log

# Secrets — never commit
.env
.env.*

# Test / scratch ZIPs (but keep committed in-tree fixtures the tests read)
*.zip
!crates/archive-core/tests/fixtures/*.zip

# Dev crate output (listings, extracted files)
crates/archive-dev/output/

# MemPalace per-project files
mempalace.yaml
entities.json
